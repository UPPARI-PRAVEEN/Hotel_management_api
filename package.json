{
  "name": "dubai-hotel-supplier-intelligence",
  "version": "1.0.0",
  "private": true,
  "main": "src/app.js",
  "scripts": {
    "start": "npm run build && node src/app.js",
    "dev": "node --watch src/app.js",
    "dev:frontend": "vite --config frontend/vite.config.mjs",
    "build": "vite build --config frontend/vite.config.mjs",
    "import:csv": "node src/ingestion/importCsv.js",
    "audit:csv": "node src/ingestion/importCsv.js --audit-only",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@clickhouse/client": "^1.11.2",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "vite": "^5.4.14"
  }
}

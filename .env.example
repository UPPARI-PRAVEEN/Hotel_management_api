NODE_ENV=development
PORT=3000
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DATABASE=hotel_intelligence
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=admin123
CSV_BATCH_SIZE=1000
DATASET_PATH=data/supplier_offers.csv
AUDIT_MIN_SAMPLES=5
AUDIT_MIN_AVAILABILITY=50
SUPPLIER_NAMES=Supplier A,Supplier B,Supplier C,Supplier D,Supplier E
RECOMMENDATION_CACHE_TTL_MS=30000
RECOMMENDATION_CACHE_STALE_TTL_MS=300000
RECOMMENDATION_CACHE_MAX_ENTRIES=1000
BENCHMARK_ITERATIONS=30
BENCHMARK_TARGET_P95_MS=500
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
